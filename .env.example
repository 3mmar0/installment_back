APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://installment-back.ammarelgndy.cloud
FRONTEND_URL=https://installment-front.ammarelgndy.cloud
CLIENT_PORTAL_URL=https://installment-front.ammarelgndy.cloud/client/register
MOBILE_APP_NAME=أقساطي
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.installmentmanager.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=installment_back
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Off by default — mail issues must not break installment/payment APIs
MAIL_NOTIFICATIONS_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated emails granted platform-admin rights.
# There is deliberately no default — an unset value grants nobody access.
PLATFORM_ADMIN_EMAILS=

# Required by DatabaseSeeder to create the first owner account.
# Seeding aborts if these are unset rather than using a known password.
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Sanctum token lifetime in minutes. Empty means tokens never expire.
# Do not enable this until refresh-capable web and mobile builds are released.
SANCTUM_TOKEN_EXPIRATION=

# Supervisor integration for the queue admin screen (platform admin only).
QUEUE_SUPERVISOR_PROGRAM=
QUEUE_SUPERVISOR_ENABLED=false
